<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="OpenEdge.Bluetooth"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:OpenEdge"
      Title="Bluetooth"
      Background="#FF101014">
  <Grid Margin="36">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid.Resources>
      <Style TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="#FFEDEDED" />
        <Setter Property="Background" Value="#66303030" />
        <Setter Property="BorderBrush" Value="#668A6AB0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="ButtonBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="5"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ButtonBorder" Property="Background" Value="#8844364F" />
                  <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#AAAE7DDB" />
                  <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="ButtonBorder" Property="Background" Value="#AA5A3C66" />
                  <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFD6A8FF" />
                  <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="ButtonBorder" Property="Background" Value="#33222222" />
                  <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#44444444" />
                  <Setter Property="Foreground" Value="#FF888888" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Foreground" Value="White" />
      </Style>
    </Grid.Resources>

    <Grid Grid.Row="0" Margin="0,0,0,20">
      <StackPanel>
        <TextBlock Text="Connect Devices"
                   FontSize="42"
                   FontWeight="SemiBold" />
        <TextBlock Text="Connect Intiface Central and assign connected devices for session use."
                   FontSize="18"
                   Foreground="#FFD6D6D6"
                   TextWrapping="Wrap"
                   Margin="0,6,80,0" />
      </StackPanel>
      <Image Source="/questionmark.png"
             Width="52"
             Height="52"
             VerticalAlignment="Top"
             HorizontalAlignment="Right"
             MouseLeftButtonUp="Image_MouseLeftButtonUp" />
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="18" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Column="0"
              Grid.Row="0"
              Grid.RowSpan="3"
              Background="#FF222228"
              BorderBrush="#668A6AB0"
              BorderThickness="1"
              CornerRadius="10"
              Padding="18">
        <StackPanel>
          <TextBlock Text="Intiface Central"
                     FontSize="26"
                     FontWeight="SemiBold"
                     Margin="0,0,0,12" />
          <Button Name="findIC"
                  Content="Find IC"
                  Click="findIC_Click" />
          <Button Name="launchBt"
                  Content="Launch IC"
                  Click="launchBt_Click" />
          <Button Name="searchBt"
                  Content="Start Scanning"
                  Click="searchBt_Click" />

          <Border Margin="0,4,0,16"
                  MinHeight="46"
                  Background="#FF1C1C22"
                  CornerRadius="6"
                  Tag="0"
                  PreviewMouseLeftButtonUp="Grid_PreviewMouseLeftButtonUp">
            <Grid Margin="12,0">
              <TextBlock Text="Launch IC on startup"
                         IsHitTestVisible="False"
                         FontSize="19"
                         VerticalAlignment="Center" />
              <CheckBox Name="onStartupIC"
                        Tag="0"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        BorderBrush="#668A6AB0"
                        Background="#FFEDEDED"
                        Click="onStartupIC_Click">
                <FrameworkElement.LayoutTransform>
                  <ScaleTransform ScaleX="1.6" ScaleY="1.6" />
                </FrameworkElement.LayoutTransform>
              </CheckBox>
            </Grid>
          </Border>

          <TextBlock Text="Server address"
                     FontSize="20"
                     Margin="0,6,0,6" />
          <TextBox Name="serverAddress"
                   FontSize="22"
                   Height="40"
                   FontFamily="Segoe UI"
                   Text="ws://localhost:12345"
                   Foreground="White"
                   Background="#FF1C1C22"
                   BorderBrush="#668A6AB0"
                   SelectionBrush="#FFAE00D7"
                   KeyUp="serverAddress_KeyUp" />
        </StackPanel>
      </Border>

      <Border Grid.Column="2"
              Grid.Row="0"
              Background="#FF222228"
              BorderBrush="#668A6AB0"
              BorderThickness="1"
              CornerRadius="10"
              Padding="16"
              MinHeight="180">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="System Events"
                     FontSize="26"
                     FontWeight="SemiBold"
                     Margin="0,0,0,10" />
          <ScrollViewer Name="btTextScroll"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        Background="#FF1C1C22">
            <Grid Margin="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="2*" />
              </Grid.ColumnDefinitions>
              <TextBlock Name="btText"
                         FontSize="18"
                         TextAlignment="Left"
                         TextWrapping="Wrap"
                         TextDecorations="Underline" />
              <TextBlock Name="btTextTimestamp"
                         Grid.Column="1"
                         FontSize="18"
                         TextAlignment="Left"
                         TextWrapping="Wrap"
                         Margin="18,0,0,0" />
            </Grid>
          </ScrollViewer>
        </Grid>
      </Border>

      <Border Grid.Column="2"
              Grid.Row="2"
              Background="#FF222228"
              BorderBrush="#668A6AB0"
              BorderThickness="1"
              CornerRadius="10"
              Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="Available Devices"
                     FontSize="26"
                     FontWeight="SemiBold"
                     Margin="0,0,0,10" />
          <ScrollViewer Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        Background="#FF1C1C22">
            <StackPanel Name="bluetoothDevicesStack"
                        Orientation="Vertical"
                        Margin="6" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Button Name="backBtn"
            Grid.Row="2"
            Content="Back"
            HorizontalAlignment="Left"
            Width="150"
            Margin="0,20,0,0"
            Click="btnBackClick" />

    <Grid Name="popQuestionmark"
          Visibility="Hidden"
          Grid.RowSpan="3"
          ZIndex="10"
          Width="700"
          Height="760"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="#FF222228">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20,20,20,80">
        <local:BluetoothHelp />
      </ScrollViewer>
      <Rectangle StrokeThickness="5">
        <Shape.Stroke>
          <LinearGradientBrush EndPoint="0,1" StartPoint="1,0">
            <GradientStop Color="#FF130613" Offset="1" />
            <GradientStop Color="#FFF53FFF" Offset="0" />
          </LinearGradientBrush>
        </Shape.Stroke>
      </Rectangle>
      <Button Content="X"
              FontSize="36"
              Background="#66303030"
              VerticalAlignment="Top"
              HorizontalAlignment="Right"
              BorderBrush="#668A6AB0"
              Foreground="White"
              Width="60"
              Height="60"
              Margin="0,10,10,0"
              Click="Button_Click" />
    </Grid>
  </Grid>
</Page>
